   "source": [
    "import re\n",
    "\n",
    "def to_salce_lan(text, consonant=\"c\"):\n",
    "    \"\"\"translate from Russian to salty language\"\"\"\n",
    "    vowels = \"аеёиоуыэюяАЕЁИОУЫЭЮЯ\"\n",
    "    result= \"\"\n",
    "\n",
    "    for char in text:\n",
    "        result+=char\n",
    "        if char in vowels:\n",
    "            result += consonant + char.lower()\n",
    "    print(result)\n",
    "\n",
    "#print(to_salce_lan(\"У попа была собака\"))\n",
    "\n",
    "def extract_chords(file_path): \n",
    "    \"\"\"Extract all chords from songs file\"\"\"\n",
    "    chords=set()\n",
    "    pattern = r'\\b[A-G][a-zbm#]*\\b'\n",
    "\n",
    "    with open(file_path, 'r') as file:\n",
    "        for line in file:\n",
    "            found=re.findall(pattern, line)\n",
    "            for chord in found:\n",
    "                chords.add(chord)\n",
    "    return chords\n",
    "\n",
    "#chords = extract_chords('data/song.txt')\n",
    "#print(chords)\n",
    "\n",
    "\n",
    "def rename_files(dir, pattern, new_pattern=None, sample_names=None, to_replace=None):\n",
    "    \"\"\"Copy and rename files\"\"\"\n",
    "    if sample_names is None: \n",
    "        sample_names = {}\n",
    "\n",
    "    for filename in os.listdir(dir): \n",
    "        filepath = os.path.join(dir, filename)\n",
    "\n",
    "        if not os.path.isfile(filepath):\n",
    "            continue\n",
    "\n",
    "        if not re.search(pattern, filename):\n",
    "            continue\n",
    "            \n",
    "        new_filename = filename\n",
    "\n",
    "        if new_pattern is not None:\n",
    "            new_filename = re.sub(patern, new_pattern, new_filename)\n",
    "\n",
    "        for old, new in sample_names.items():\n",
    "            new_filename = new_filename.replace(old, new)\n",
    "\n",
    "        if filename == new_filename:\n",
    "            continue\n",
    "\n",
    "        new_filepath = os.path.join(dir, new_filename)\n",
    "\n",
    "        if to_replace:\n",
    "            os.rename(filepath, new_filepath)\n",
    "        else: \n",
    "            with open(filepath, 'rb') as f1, open(new_filepath, 'wb') as f2:\n",
    "                f2.write(f1.read())"
   ]
  }
 ],
